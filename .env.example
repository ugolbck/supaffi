# Copy to .env for local development.
# The self-host installer writes its own .env; these values are development ones.

DATABASE_URL=postgres://supaffi:devpassword@localhost:5432/supaffi

# The bare hostname this Instance's own dashboard is served on. Set by the
# installer. Caddy serves it from a named site block with an ordinary
# certificate, which is what makes a fresh install reachable before any
# Merchant exists. A Merchant may not use this domain.
# Unset in development, where the dashboard is on localhost.
SUPAFFI_DOMAIN=

# The address the dashboard is served on when this instance has no domain,
# which is the normal case. Written by the installer. Your browser warns once,
# because the certificate is signed by your own server rather than by an
# authority it knows. The connection is encrypted either way.
SUPAFFI_HOST_IP=

# Where that dashboard listens.
SUPAFFI_DASHBOARD_PORT=3443

# Which services run. The installer always includes dashboard-tls, which
# serves the dashboard on SUPAFFI_HOST_IP above. It adds bundled-proxy when
# Supaffi also owns ports 80 and 443 for your program hostnames; without it
# nothing binds 80 or 443 and your own reverse proxy forwards to
# SUPAFFI_APP_BIND below.
#
# Chosen once, on the first install, and then left alone. Re-deciding it on a
# later run would find Supaffi's own Caddy holding those ports, conclude that
# something else owns them, and shut your programs down mid-update.
COMPOSE_PROFILES=

# Where the app's port lands on the host. Loopback by default, which is what
# a reverse proxy on the same machine needs. Only widen this if you know why
# you are doing it: Docker's firewall rules take precedence over ufw and
# firewalld, so 0.0.0.0 here is reachable from the internet even on a host
# you believe is firewalled.
SUPAFFI_APP_BIND=127.0.0.1:3000

# The tests clear whole tables, so they never touch the database above.
# They append `_test` to its name and refuse to run against anything else.
# Create it once: createdb supaffi_test && DATABASE_URL=...supaffi_test npx prisma migrate deploy

# Decrypts each Merchant's Stripe and email credentials (ADR 0003).
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# Signs Owner session JWTs.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# One instance serves many Merchant domains (ADR 0006), so there is no single
# AUTH_URL to pin.
AUTH_TRUST_HOST=true

# Print emails to the terminal instead of sending them (ADR 0008). Affiliate
# magic links are sent from affiliates@<merchant domain>, which locally is
# localhost, and no provider will let you send from that.
#
# Unset means send. Never set this in production: the printed links are live
# single-use login tokens, so anyone who can read the logs can take over any
# affiliate account.
EMAIL_DELIVERY=console
