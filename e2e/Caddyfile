# The production Caddyfile's shape with every certificate from Caddy's own
# local CA, since nothing in the suite can reach a public one. Product domains
# still go through on-demand TLS and the app's ask endpoint, as they do live.
{
	local_certs
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
	}
}

https://admin.test {
	reverse_proxy app:3000
}

https://shop.test {
	reverse_proxy merchant:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}
