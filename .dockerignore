# The builder stage does COPY . ., so anything not excluded here is sent to the
# daemon and baked into that layer.

# Secrets. .env holds MASTER_ENCRYPTION_KEY and AUTH_SECRET.
.env
.env.*
!.env.example

# Rebuilt inside the image, and copying a host build wastes the layer cache.
node_modules/
.next/

.git/
.gitignore

# Local planning docs, never part of a build.
docs/
CONTEXT.md
.superpowers/

# Tests and tooling the runtime never loads.
test/
vitest.config.ts

# Database dumps. install.sh writes one here before every update and never
# prunes them, so on a self-hosted server this directory holds the owner's
# password hash, every affiliate's email, and encrypted Stripe key material.
# The build context is that same directory, so without this line a source
# build bakes the lot into an image layer.
backups/

# Compose and deploy files describe the container, they do not belong in it.
docker-compose.yml
docker-compose.build.yml
docker-compose.override.yml*
Caddyfile
Caddyfile.dashboard
install.sh
CHANGELOG.md
README.md
.github/
